# Run each scenario in an isolated directory so optional plots never open a GUI.
function(simulate scenario input)
    set(dir "${CMAKE_CURRENT_BINARY_DIR}/console/${scenario}")
    file(MAKE_DIRECTORY "${dir}")
    file(WRITE "${dir}/input.txt" "${input}")
    file(GLOB previous "${dir}/*.csv")
    if(previous)
        file(REMOVE ${previous})
    endif()
    execute_process(COMMAND "${PROGRAM}" WORKING_DIRECTORY "${dir}"
        INPUT_FILE "${dir}/input.txt" OUTPUT_VARIABLE output
        ENCODING UTF-8 COMMAND_ERROR_IS_FATAL ANY TIMEOUT 15)
    set(result "${output}" PARENT_SCOPE)
    set(folder "${dir}" PARENT_SCOPE)
endfunction()

simulate(all "1\n3\n")
foreach(model IN ITEMS 1_4 2_6 3_8)
    foreach(signal IN ITEMS step impulse harmonic)
        file(STRINGS "${folder}/model_${model}_${signal}.csv" rows)
        list(LENGTH rows count)
        list(GET rows 0 header)
        if(NOT count EQUAL 5 OR NOT header STREQUAL "tau,u,y")
            message(FATAL_ERROR "Invalid CSV for ${model} / ${signal}")
        endif()
    endforeach()
endforeach()

function(check_pole a expected)
    simulate("pole_${a}" "2\n1\n${a}\n1\n2\n2\n1\n")
    string(FIND "${result}" "ВНИМАНИЕ" warning)
    string(FIND "${result}" "${expected}" detail)
    string(FIND "${result}" "tau" table)
    if(detail LESS 0 OR (a LESS 1 AND a GREATER -1 AND warning GREATER_EQUAL 0)
       OR ((a GREATER_EQUAL 1 OR a LESS_EQUAL -1) AND (warning LESS 0 OR warning GREATER table)))
        message(FATAL_ERROR "Incorrect stability output for a=${a}")
    endif()
endfunction()
check_pole(0.5 "Model 1.4")
check_pole(-1 "не затухает")
check_pole(1.2 "расходится")

simulate(custom "bad\n2\n3\n0\n0\n1\n-1\n0.5\n1\n2xyz\n2\n2\n3\n")
file(STRINGS "${folder}/model_3_8_step.csv" rows)
if(NOT rows STREQUAL "tau,u,y;0,2,3;1,2,4;2,2,5")
    message(FATAL_ERROR "Unexpected Euler trajectory after invalid input: ${rows}")
endif()
simulate(nonlinear "2\n2\n1\n0\n2\n3\n1\n1\n1\n")
file(STRINGS "${folder}/model_2_6_harmonic.csv" rows)
list(GET rows 2 final)
if(NOT final MATCHES "^1,0[.]84147[0-9]*,1$")
    message(FATAL_ERROR "Unexpected nonlinear output: ${final}")
endif()
